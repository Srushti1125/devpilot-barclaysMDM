# PostgreSQL (pgvector-enabled) — shared app database. With `docker compose up db`,
# the host port is 5433, not 5432.
DATABASE_URL=postgresql+psycopg://devpilot:devpilot@localhost:5433/devpilot

# LLM routing: Groq first for generation, Gemini fallback.
# Embeddings ALWAYS use Gemini (Groq has no embedding API) — GOOGLE_API_KEY is required.
GROQ_API_KEY=gsk_your_groq_key
GOOGLE_API_KEY=your_gemini_key
DEFAULT_LLM=groq-openai/gpt-oss-120b
FALLBACK_LLM=gemini-3.6-flash

# Optional providers / features — the system degrades gracefully without these:
MISTRAL_API_KEY=
COHERE_API_KEY=            # cloud reranking (§2.2.3); no key = base MMR retrieval
EVAL_JUDGE_LLM=            # online LLM-as-Judge model (§3.2.1); defaults to FALLBACK_LLM

# Vector store
COLLECTION_NAME=devpilot_requirements

# Hybrid retrieval (§2.3) — defaults keep vector-only behavior until §2.3.6 ship criteria pass
RETRIEVAL_MODE=vector
TREE_TIMEOUT_S=8
VECTOR_TIMEOUT_S=5
TREE_SELECT_TOKEN_BUDGET=3000
TREE_CONCURRENCY=4
RETRIEVAL_CONTEXT_TOKENS=3000

# Ingestion
DOCLING_ENABLED=true

# Service
AI_ENGINE_PORT=8001
LOG_LEVEL=INFO
DAILY_REQUEST_QUOTA=1500
