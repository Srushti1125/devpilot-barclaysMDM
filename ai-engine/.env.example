# DevPilot AI Engine — environment template. Copy to .env and fill in.
# All keys are read by app/config.py (Settings). Only GOOGLE_API_KEY, GROQ_API_KEY
# (when a groq-* alias is used) and DATABASE_URL are needed for real calls; the
# test suite runs with none of them set.

# --- Database (pgvector-enabled Postgres) ---
# Local run against docker-compose: port is 5433 on the host, 5432 inside the network.
DATABASE_URL=postgresql+psycopg://devpilot:<YOUR_PASSWORD>@localhost:5433/devpilot
COLLECTION_NAME=devpilot_requirements

# --- Embeddings (always Gemini; Groq has no embedding API) ---
GOOGLE_API_KEY=your_gemini_key

# --- LLM routing: aliases are "groq-<model>" or "gemini-<model>" ---
DEFAULT_LLM=groq-openai/gpt-oss-120b
GROQ_API_KEY=your_groq_key
FALLBACK_LLM=gemini-3.6-flash          # gemini-2.5-* 404s on new free-tier keys
MISTRAL_API_KEY=                       # optional: mistral-* aliases only

# --- Online evaluation / LLM-as-Judge (SOP graph qa node) ---
# Keep this on a fast model: worst case per request is 3 drafts + 3 judge calls (W-3).
EVAL_JUDGE_LLM=gemini-3.6-flash

# --- Ingestion parser ---
DOCLING_ENABLED=true                   # false -> unstructured loader only

# --- Hybrid retrieval (vector = default until the §2.3.6 ship criteria pass) ---
RETRIEVAL_MODE=vector                  # vector | hybrid
TREE_TIMEOUT_S=8                       # placeholder; re-tune from Phase 5 benchmarks
VECTOR_TIMEOUT_S=5
TREE_SELECT_TOKEN_BUDGET=3000
TREE_CONCURRENCY=4                     # semaphore: concurrent tree searches per process
RETRIEVAL_CONTEXT_TOKENS=3000

# --- Cloud reranking (graceful degradation: unset = no rerank) ---
COHERE_API_KEY=
RERANK_TOP_N=4

# --- Service ---
AI_ENGINE_PORT=8001
LOG_LEVEL=INFO

# --- Quota guardrail (soft limit, logged not enforced) ---
DAILY_REQUEST_QUOTA=1500
